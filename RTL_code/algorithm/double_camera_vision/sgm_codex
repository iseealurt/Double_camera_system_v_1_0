// ========================================================================
// SGM 立体匹配算法 RTL 伪代码（Codex 版）
// 说明：右摄像头为基准计算右视差图，2 路径聚合架构
// ========================================================================
module sgm_new#(
    parameter   IMG_WIDTH       =   640     ,   // 图像宽度：640像素
    parameter   IMG_HEIGHT      =   480     ,   // 图像高度：480像素
    parameter   MAX_MATCH_DEPTH =   48      ,   // 最大视差搜索范围：0~47
    parameter   CENSUS_WIDTH    =   24      ,   // Census变换位宽：5×5窗口=24bit
    parameter   DISPARITU_WIDTH =   8       ,   // 视差输出位宽：uint8
    parameter   SGM_P1          =   15      ,   // 视差变化=1的惩罚参数
    parameter   SGM_P2          =   100     ,   // 视差变化>=2的惩罚参数
    parameter   SGM_INVALID_COST=   24          // 无效匹配的最大代价值
)(
    input   wire                            clk                 ,   // 系统时钟
    input   wire                            rst_n               ,   // 复位，低有效

    input   wire                            per_cmr1_vsync      ,   // 左摄像头场同步
    input   wire                            per_cmr1_href       ,   // 左摄像头行同步
    input   wire    [CENSUS_WIDTH-1:0]      per_cmr1_census     ,   // 左目24bit Census输入

    input   wire                            per_cmr2_vsync      ,   // 右摄像头场同步
    input   wire                            per_cmr2_href       ,   // 右摄像头行同步
    input   wire    [CENSUS_WIDTH-1:0]      per_cmr2_census     ,   // 右目24bit Census输入

    output  wire                            disparity_vsync     ,   // 视差输出场同步
    output  wire                            disparity_href      ,   // 视差输出行同步
    output  wire    [DISPARITU_WIDTH-1:0]   disparity               // 视差结果输出
);
    // ====================================================================
    // 前置FIFO预读控制
    // 关键：右目为参考时，左目需要提前dmax个像素，保证匹配窗口填满
    // ====================================================================
    wire                                    cmr1_census_fifo_pre_rd_en;

    // 左目 href 打 1 拍用于检测下降沿
    reg                                     per_cmr1_href_dly;
    always@(posedge clk) begin : cmr1_href_delay
        if(!rst_n) begin
            per_cmr1_href_dly <= 1'b0;
        end
        else begin
            per_cmr1_href_dly <= per_cmr1_href;   // dly[0] = href 延迟1拍
        end
    end

    // 检测左目 href 下降沿：每行结束时触发预读
    wire                                    per_cmr1_href_negedge;
    assign per_cmr1_href_negedge = per_cmr1_href_dly && !per_cmr1_href;
    //            上一拍还是高                     这一拍变低  =  下降沿

    // 预读计数器位宽：$clog2(48+1) = 6bit
    localparam PRE_RD_CNT_DIGITS = $clog2(MAX_MATCH_DEPTH+1);
    reg [PRE_RD_CNT_DIGITS-1:0] cmr1_census_fifo_pre_rd_cnt;

    always@(posedge clk) begin : cmr1_census_fifo_pre_rd_cnt_behavior
        if(!rst_n) begin
            cmr1_census_fifo_pre_rd_cnt <= MAX_MATCH_DEPTH - 1'b1;  // 初始：计数满=不预读
        end
        else begin
            // 每行结束(href下降沿)时，计数器清零，开始预读 dmax 个像素
            if(per_cmr1_href_negedge) begin
                cmr1_census_fifo_pre_rd_cnt <= {PRE_RD_CNT_DIGITS{1'b0}};
            end
            else begin
                // 从 0 计数到 47，共 48 个周期预读
                // 计数到 47 后保持，不再预读
                cmr1_census_fifo_pre_rd_cnt <= cmr1_census_fifo_pre_rd_cnt == MAX_MATCH_DEPTH - 1'b1
                                             ? MAX_MATCH_DEPTH - 1'b1  // 保持最大值
                                             : cmr1_census_fifo_pre_rd_cnt + 1'b1;  // 否则加1
            end   
        end
    end

    // 预读使能：计数器 < 47 时预读，=47 时停止
    assign cmr1_census_fifo_pre_rd_en = (cmr1_census_fifo_pre_rd_cnt == MAX_MATCH_DEPTH - 1'b1) ? 1'b0 : 1'b1;

    // ====================================================================
    // 左目 Census FIFO：用于左右目同步和预读
    // ====================================================================
    wire    [CENSUS_WIDTH-1:0]              cmr1_census_fifo_din , cmr1_census_fifo_dout;
    wire                                    cmr1_census_fifo_wr_en , cmr1_census_fifo_rd_en;
    wire                                    cmr1_census_fifo_empty , cmr1_census_fifo_full;
    wire                                    cmr1_census_fifo_rst;

    assign cmr1_census_fifo_rst = !per_cmr1_vsync;  // 场同步时复位FIFO
    assign cmr1_census_fifo_wr_en = per_cmr1_href && !cmr1_census_fifo_full;  // 左目行有效时写入
    // FIFO 读出条件：预读阶段 OR 右目行有效阶段，且FIFO非空
    assign cmr1_census_fifo_rd_en = (cmr1_census_fifo_pre_rd_en || per_cmr2_href) && !cmr1_census_fifo_empty; 
    assign cmr1_census_fifo_din = per_cmr1_census;  // FIFO输入 = 左目Census
    
    // ======================================
    // FIFO IP 例化要点：
    //   - 位宽：24bit，深度：1024
    //   - 消耗 3 个 DRK9K RAM 块
    //   - 开启输出寄存器，第一拍下降沿输出
    // ======================================

    // ====================================================================
    // href 延迟链：为多级流水线准备行有效信号
    // ====================================================================
    localparam HREF_MAX_DLY_CYCLE = 15;   // 预留足够深度的延迟链
    reg [HREF_MAX_DLY_CYCLE-1:0] per_cmr2_href_dly;

    always@(posedge clk) begin : cmr2_href_delay
        if(!rst_n) begin
            per_cmr2_href_dly <= {{HREF_MAX_DLY_CYCLE{1'b0}}};
        end
        else begin
            // 移位寄存器：dly[n] = href 延迟 n 拍
            // 输入位：dly[0] = 当前 href
            // 输出位：dly[1..14] = 延迟 1~14 拍
            per_cmr2_href_dly <= {per_cmr2_href_dly[HREF_MAX_DLY_CYCLE-2:0], per_cmr2_href};
        end
    end

    // ====================================================================
    // STAGE 0：匹配窗口生成 → 移位寄存器架构
    // xor_window[d] = 左目在视差 d 处的 Census 值
    // ====================================================================
    reg [CENSUS_WIDTH-1:0] xor_window[MAX_MATCH_DEPTH-1:0];
    integer i;

    always@(posedge clk) begin : xor_window_generate
        if(!rst_n) begin
            for(i=0;i<MAX_MATCH_DEPTH;i=i+1) begin
                xor_window[i] <= {CENSUS_WIDTH{1'b0}};   // 复位清0
            end
        end
        else begin
            if(per_cmr2_href_dly[0]) begin   // 延迟0拍的href控制
                // 新像素移到窗口第0位
                xor_window[0] <= cmr1_census_fifo_dout;
                // 所有旧像素向后移动一位
                // xor_window[d] = d 个周期前的左目像素
                for(i=1;i<MAX_MATCH_DEPTH;i=i+1) begin
                    xor_window[i] <=  xor_window[i-1];
                end
            end
        end
    end

    // ====================================================================
    // STAGE 1：右目 Census 打拍对齐 + 异或计算
    // ====================================================================
    // 右目打 2 拍，与移位窗口输出对齐
    reg [CENSUS_WIDTH-1:0] cmr2_census_dly[1:0];

    always@(posedge clk) begin : cmr2_census_delay
        if(!rst_n) begin
            cmr2_census_dly[0] <= {{CENSUS_WIDTH{1'b0}}};
            cmr2_census_dly[1] <= {{CENSUS_WIDTH{1'b0}}};
        end
        else begin
            cmr2_census_dly[0] <= per_cmr2_census;      // 第1拍延迟
            cmr2_census_dly[1] <= cmr2_census_dly[0];   // 第2拍延迟
        end
    end

    // 所有视差级别同时异或：左目窗口 vs 右目当前像素
    reg [CENSUS_WIDTH-1:0] xor_outcome[MAX_MATCH_DEPTH-1:0];

    always@(posedge clk) begin : xor_computation
        if(!rst_n) begin
            for(i=0;i<MAX_MATCH_DEPTH;i=i+1) begin
                xor_outcome[i] <= {CENSUS_WIDTH{1'b0}};
            end
        end
        else begin
            if(per_cmr2_href_dly[1]) begin   // 延迟1拍的href控制
                // 对每个视差 d，左目(x-d) ^ 右目(x)
                // 相同=0，不同=1 → 1的个数就是汉明距离
                for(i=0;i<MAX_MATCH_DEPTH;i=i+1) begin
                    xor_outcome[i] <=  xor_window[i] ^ cmr2_census_dly[1];
                end
            end
        end
    end

    // ====================================================================
    // STAGE 2：基于 LUT6 的 6bit popcount（第一级）
    // 24bit 拆分为 4 组 × 6bit，每组用 LUT6 实现 1 的个数统计
    // ====================================================================
    localparam POPCOUNT_REG_NUM = CENSUS_WIDTH / 6 * MAX_MATCH_DEPTH; 
    // POPCOUNT_REG_NUM = 24/6 * 48 = 4 * 48 = 192 个寄存器

    localparam GROUP_PER_DISP = CENSUS_WIDTH / 6;  // 每个视差分4组：每组6bit
    reg     [2:0] popcount_s1[POPCOUNT_REG_NUM-1:0];  // 每组结果0~6 → 3bit足够
    integer j;

    always @(posedge clk) begin : hamming_popcount_s1
        if(!rst_n) begin
            for(i = 0; i < POPCOUNT_REG_NUM; i = i + 1) begin
                popcount_s1[i] <= 3'd0;
            end
        end
        else begin
            if(per_cmr2_href_dly[2]) begin   // 延迟2拍的href控制
                // 遍历每个视差级别
                for(i = 0; i < MAX_MATCH_DEPTH; i = i + 1) begin
                    // 每个视差分 4 组 6bit
                    for(j = 0; j < GROUP_PER_DISP; j = j + 1) begin
                        // 取 xor_outcome[i] 的第 j 组 6bit: j*6 + 6位
                        case (xor_outcome[i][j*6 +: 6])
                            6'b000000: popcount_s1[i*GROUP_PER_DISP + j] <= 3'd0;
                            
                            // 6种组合 = 1个'1'
                            6'b000001, 6'b000010, 6'b000100, 6'b001000, 6'b010000, 6'b100000:
                                popcount_s1[i*GROUP_PER_DISP + j] <= 3'd1;

                            // 15种组合 = 2个'1'
                            6'b000011, 6'b000101, 6'b000110, 6'b001001, 6'b001010, 6'b001100,
                            6'b010001, 6'b010010, 6'b010100, 6'b011000, 6'b100001, 6'b100010,
                            6'b100100, 6'b101000, 6'b110000:
                                popcount_s1[i*GROUP_PER_DISP + j] <= 3'd2;

                            // 20种组合 = 3个'1'
                            6'b000111, 6'b001011, 6'b001101, 6'b001110, 6'b010011, 6'b010101,
                            6'b010110, 6'b011001, 6'b011010, 6'b011100, 6'b100011, 6'b100101,
                            6'b100110, 6'b101001, 6'b101010, 6'b101100, 6'b110001, 6'b110010,
                            6'b110100, 6'b111000:
                                popcount_s1[i*GROUP_PER_DISP + j] <= 3'd3;

                            // 15种组合 = 4个'1'
                            6'b001111, 6'b010111, 6'b011011, 6'b011101, 6'b011110, 6'b100111,
                            6'b101011, 6'b101101, 6'b101110, 6'b110011, 6'b110101, 6'b110110,
                            6'b111001, 6'b111010, 6'b111100:
                                popcount_s1[i*GROUP_PER_DISP + j] <= 3'd4;

                            // 6种组合 = 5个'1'
                            6'b011111, 6'b101111, 6'b110111, 6'b111011, 6'b111101, 6'b111110:
                                popcount_s1[i*GROUP_PER_DISP + j] <= 3'd5;

                            // 1种组合 = 6个'1'
                            6'b111111: popcount_s1[i*GROUP_PER_DISP + j] <= 3'd6;

                            default: popcount_s1[i*GROUP_PER_DISP + j] <= 3'd0;
                        endcase
                    end
                end
            end
        end
    end

    // ====================================================================
    // STAGE 3：列计数 + 掩码生成 + popcount 第二级相加
    // ====================================================================
    localparam COL_WIDTH = $clog2(IMG_WIDTH);  // $clog2(640) = 10bit
    reg [COL_WIDTH-1:0] cmr2_col_cnt;          // 行内列计数器

    always@(posedge clk) begin
        if(!rst_n) begin
            cmr2_col_cnt <= {COL_WIDTH{1'b0}};
        end
        else begin
            // href 上升沿检测：!dly[3] && dly[4] = 前一拍低，这一拍高
            if(!per_cmr2_href_dly[3] && per_cmr2_href_dly[4]) begin
                cmr2_col_cnt <= {COL_WIDTH{1'b0}};  // 每行开始清零列计数
            end
            // 行有效时列计数加1
            else if(per_cmr2_href_dly[3]) begin
                cmr2_col_cnt <= cmr2_col_cnt + 1'b1;
                // 超范围报警
                if(cmr2_col_cnt >= IMG_WIDTH)
                    $display("@ %0t , [ERROR] per_cmr2_href lasted too long for %0d cycles",
                             $time, cmr2_col_cnt + 1);
            end          
        end
    end

    // --------------------------
    // 匹配有效性掩码（组合逻辑）
    // 右视差图的右边界无效处理
    // --------------------------
    reg                      hamming_dist_valid_mask_pre;

    always@(*) begin : hamming_dist_valid_mask_pre_combine_logic
        hamming_dist_valid_mask_pre = 1'b1;  // 默认有效
        
        // 当列号 > 640-48-1 = 591 时，匹配越界
        // 即最后 48 列无法形成完整匹配窗口，置无效
        if(cmr2_col_cnt > IMG_WIDTH - MAX_MATCH_DEPTH - 1'b1) begin
            hamming_dist_valid_mask_pre = 1'b0;
        end
    end

    // --------------------------
    // popcount 第二级：4组→2组 两两相加
    // --------------------------
    localparam HAMMING_WIDTH = $clog2(CENSUS_WIDTH + 1);  // $clog2(25) = 5bit
    reg [HAMMING_WIDTH-1:0] popcount_s2[MAX_MATCH_DEPTH-1:0][(GROUP_PER_DISP/2)-1:0];

    always @(posedge clk) begin
        if(!rst_n) begin
            for(i = 0; i < MAX_MATCH_DEPTH; i = i + 1)
                for(j = 0; j < GROUP_PER_DISP/2; j = j + 1)
                    popcount_s2[i][j] <= 0;
        end
        else begin
            if(per_cmr2_href_dly[3]) begin   // 延迟3拍的href控制
                for(i = 0; i < MAX_MATCH_DEPTH; i = i + 1) begin
                    // 第 0 组 + 第 1 组 → s2[0]
                    // 第 2 组 + 第 3 组 → s2[1]
                    for(j = 0; j < GROUP_PER_DISP/2; j = j + 1) begin
                        popcount_s2[i][j] <= popcount_s1[i*GROUP_PER_DISP + 2*j]
                                          + popcount_s1[i*GROUP_PER_DISP + 2*j + 1];
                    end
                end
            end 
        end
    end

    // ====================================================================
    // STAGE 4：popcount 第三级 → 最终汉明距离
    // s2[0] + s2[1] = 最终汉明距离（范围 0~24）
    // ====================================================================
    reg [HAMMING_WIDTH-1:0] hamming_dist[MAX_MATCH_DEPTH-1:0];

    always @(posedge clk) begin : hamming_dist_compute
        if(!rst_n) begin
            for(i = 0; i < MAX_MATCH_DEPTH; i = i + 1)
                hamming_dist[i] <= {HAMMING_WIDTH{1'b1}};  // 复位时置最大代价
        end
        else begin
            if(per_cmr2_href_dly[4]) begin   // 延迟4拍的href控制
                for(i=0;i<MAX_MATCH_DEPTH;i=i+1) begin
                    for(j=0;j<GROUP_PER_DISP/2;j=j+1) begin
                        // mask=1: 有效，输出两组相加的汉明距离
                        // mask=0: 无效，强制输出最大代价24
                        hamming_dist[i] <= hamming_dist_valid_mask_pre
                                         ? popcount_s2[i][j*2] + popcount_s2[i][j*2+1]
                                         : 24;
                    end
                end
            end            
        end
    end

    // ====================================================================
    // STAGE 5：代价 FIFO 缓冲（48 视差独立 FIFO）
    // 作用：吸收流水线延迟，便于后续聚合模块时序收敛
    // ====================================================================
    wire   [HAMMING_WIDTH-1:0]      cost_fifo_din[MAX_MATCH_DEPTH-1:0], cost_fifo_dout[MAX_MATCH_DEPTH-1:0];
    wire   [MAX_MATCH_DEPTH-1:0]    cost_fifo_wr_en, cost_fifo_rd_en;
    wire   [MAX_MATCH_DEPTH-1:0]    cost_fifo_full, cost_fifo_empty;

    localparam COST_FIFO_MIN_DEPTH = 8;  // 深度8即可覆盖所有流水线延迟

    generate 
        begin : fifo_buffer
            genvar fifo_cnt;
            // 每个视差一个独立 FIFO（共 48 个小 FIFO）
            for(fifo_cnt = 0; fifo_cnt < MAX_MATCH_DEPTH; fifo_cnt = fifo_cnt + 1) begin
                assign cost_fifo_din[fifo_cnt] = hamming_dist[fifo_cnt];
                assign cost_fifo_wr_en[fifo_cnt] = per_cmr2_href_dly[5];
                // ======================================
                // FIFO IP 例化模板：
                // 位宽：HAMMING_WIDTH = 5bit
                // 深度：COST_FIFO_MIN_DEPTH = 8
                // 类型：SRL16 或分布式 RAM（小深度不需要 BRAM）
                // ======================================
            end
        end
    endgenerate

    // ====================================================================
    // STAGE 6：双路径代价聚合模块例化
    // ====================================================================
    sgm_2path_agg #(
        .D(MAX_MATCH_DEPTH),
        .IMG_WIDTH(IMG_WIDTH),
        .COST_WIDTH(HAMMING_WIDTH),
        .LR_WIDTH(10),
        .P1(SGM_P1),
        .P2(SGM_P2)
    ) u_2path_agg (
        .clk(clk),
        .rst_n(rst_n),
        .href(per_cmr2_href_dly[6]),   // 延迟6拍的href
        .vsync(per_cmr2_vsync),
        .hamming_dist(cost_fifo_dout), // FIFO输出的汉明距离
        .S_out()                       // 聚合后的最终代价
    );

endmodule

// ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
// 模块：sgm_2path_agg - 双路径代价聚合核心
// 聚合路径：左→右（行方向） + 上→下（列方向）
// 架构：单周期完成 2 个路径的并行递推！
// ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
module sgm_2path_agg #(
    parameter D = 48,               // 视差数
    parameter IMG_WIDTH = 640,      // 图像宽
    parameter COST_WIDTH = 6,       // 汉明距离位宽
    parameter LR_WIDTH   = 10,      // 累积代价位宽（足够容纳溢出）
    parameter P1 = 15,              // 视差±1惩罚
    parameter P2 = 100              // 视差跳变惩罚
)(
    input  wire                     clk,
    input  wire                     rst_n,

    input  wire                     href,       // 行有效
    input  wire                     vsync,      // 场有效

    input  wire [COST_WIDTH-1:0]    hamming_dist [0:D-1],   // 输入：48个视差的汉明距离

    output reg  [LR_WIDTH-1:0]      S_out [0:D-1]           // 输出：聚合后总代价
);

    // =====================================================
    // 行列坐标计数器：用于 RAM 寻址和边界处理
    // =====================================================
    reg [10:0] col_cnt;   // 列坐标 0~639
    reg [10:0] row_cnt;   // 行坐标 0~479

    always @(posedge clk) begin
        if(!rst_n) begin
            col_cnt <= 0;
            row_cnt <= 0;
        end
        else if(href) begin
            // 一行结束：列清零，行加1
            if(col_cnt == IMG_WIDTH-1) begin
                col_cnt <= 0;
                row_cnt <= row_cnt + 1;
            end
            // 正常行内：列加1
            else begin
                col_cnt <= col_cnt + 1;
            end
        end
    end

    // =====================================================
    // 左→右路径：前一个像素的累积代价寄存器
    // =====================================================
    reg [LR_WIDTH-1:0] Lr_row_prev [0:D-1];   // 左边(x-1,y)的代价
    reg [LR_WIDTH-1:0] Lr_row_curr [0:D-1];   // 当前(x,y)的代价

    // =====================================================
    // 上→下路径：上一行的累积代价 RAM（48个独立RAM bank）
    // 每个视差一个独立 RAM bank，总共 48 × 640 = 30720 个位置
    // =====================================================
    reg [LR_WIDTH-1:0] Lr_col_ram [0:D-1][0:IMG_WIDTH-1];

    reg [LR_WIDTH-1:0] Lr_col_prev [0:D-1];   // 上边(x,y-1)的代价
    reg [LR_WIDTH-1:0] Lr_col_curr [0:D-1];   // 当前(x,y)的代价

    // =====================================================
    // Stage 1：并行求两个路径前一位置的最小代价（组合逻辑）
    // 48输入比较树，求 min{Lr_prev[0..47]}
    // =====================================================
    reg [LR_WIDTH-1:0] min_row, min_col;

    integer i;

    always @(*) begin
        // 行方向前一位置的所有视差最小值
        min_row = Lr_row_prev[0];
        // 列方向前一位置的所有视差最小值
        min_col = Lr_col_prev[0];

        for(i=1;i<D;i=i+1) begin
            if(Lr_row_prev[i] < min_row)
                min_row = Lr_row_prev[i];

            if(Lr_col_prev[i] < min_col)
                min_col = Lr_col_prev[i];
        end
    end

    // =====================================================
    // Stage 2 + Stage 3：SGM 核心递推公式并行执行
    //           单周期同时完成行+列两个路径的计算！
    // =====================================================
    integer d;

    always @(posedge clk) begin
        if(!rst_n) begin
            for(d=0; d<D; d=d+1) begin
                Lr_row_prev[d] <= 0;
                Lr_col_prev[d] <= 0;
            end
        end
        else if(href) begin

            // --------------------------
            // 第一步：读列 RAM（读取上一行的结果）
            // --------------------------
            for(d=0; d<D; d=d+1) begin
                if(row_cnt == 0)
                    // 第一行：无上一行参考，置0
                    Lr_col_prev[d] <= 0;
                else
                    // 其他行：读 RAM 中上一行同一列的结果
                    Lr_col_prev[d] <= Lr_col_ram[d][col_cnt];
            end

            // --------------------------
            // 第二步：并行执行 SGM 四取一公式
            // Lr_curr = C + min(L0, L-1+P1, L+1+P1, min_all+P2) - min_all
            // --------------------------
            for(d=0; d<D; d=d+1) begin
                reg [LR_WIDTH-1:0] r0,r1,r2,r3;   // 行方向4个候选项
                reg [LR_WIDTH-1:0] c0,c1,c2,c3;   // 列方向4个候选项

                // ==========================================
                // 左→右路径公式
                // ==========================================
                // 项1：视差不变
                r0 = Lr_row_prev[d] - min_row;

                // 项2：视差-1（d从d-1变来）+ P1惩罚
                r1 = (d==0) ? {LR_WIDTH{1'b1}} :  // d=0时d-1越界→无穷大
                     Lr_row_prev[d-1] - min_row + P1;

                // 项3：视差+1（d从d+1变来）+ P1惩罚
                r2 = (d==D-1) ? {LR_WIDTH{1'b1}} :  // d=D-1时d+1越界→无穷大
                     Lr_row_prev[d+1] - min_row + P1;

                // 项4：视差任意跳变 + P2惩罚
                r3 = P2;

                // 四项取最小值 + 当前像素原始代价
                Lr_row_curr[d] <= hamming_dist[d] + min4(r0, r1, r2, r3);

                // ==========================================
                // 上→下路径公式（结构完全同上行）
                // ==========================================
                // 项1：视差不变
                c0 = Lr_col_prev[d] - min_col;

                // 项2：视差-1 + P1惩罚
                c1 = (d==0) ? {LR_WIDTH{1'b1}} :
                     Lr_col_prev[d-1] - min_col + P1;

                // 项3：视差+1 + P1惩罚
                c2 = (d==D-1) ? {LR_WIDTH{1'b1}} :
                     Lr_col_prev[d+1] - min_col + P1;

                // 项4：视差任意跳变 + P2惩罚
                c3 = P2;

                // 四项取最小值 + 当前像素原始代价
                Lr_col_curr[d] <= hamming_dist[d] + min4(c0, c1, c2, c3);
            end

            // =================================================
            // Stage 4：更新状态寄存器 + 写列RAM
            // =================================================
            for(d=0; d<D; d=d+1) begin
                // 行方向：每行第0列重置，否则更新为当前值
                Lr_row_prev[d] <= (col_cnt==0) ? 0 : Lr_row_curr[d];
                
                // 列方向：将当前结果写入 RAM，供下一行同一列使用
                Lr_col_ram[d][col_cnt] <= Lr_col_curr[d];

                // ========== 最终输出：两个路径代价直接相加 ==========
                // S = Lr_row + Lr_col
                S_out[d] <= Lr_row_curr[d] + Lr_col_curr[d];
            end
        end
    end

    // =====================================================
    // 辅助函数：4 输入最小值比较（三级比较树）
    // =====================================================
    function [LR_WIDTH-1:0] min4;
        input [LR_WIDTH-1:0] a,b,c,d;
        reg [LR_WIDTH-1:0] m1,m2;
        begin
            m1 = (a<b)?a:b;    // 第1级：a vs b
            m2 = (c<d)?c:d;    // 第1级：c vs d
            min4 = (m1<m2)?m1:m2;  // 第2级：胜者决赛
        end
    endfunction

endmodule

/*
===========================================================================
                      RTL 架构关键设计要点总结
===========================================================================

【汉明距离流水线】
  Stage 0: 移位寄存器匹配窗口 → 1拍
  Stage 1: 异或运算           → 1拍
  Stage 2: 6bit LUT popcount  → 1拍
  Stage 3: 第一次加法树       → 1拍
  Stage 4: 第二次加法树+掩码  → 1拍
  ---------------------------------------
  合计: 5拍流水线延迟

【代价聚合架构亮点】
  1. 48 个视差完全并行计算
  2. 行+列 双路径在同一周期完成，吞吐量 = 1像素/周期
  3. 列方向使用 48 个独立 RAM bank，无读写冲突
  4. 单周期完成：读RAM + 递推 + 写RAM + 输出
  5. 所有计算在一个时钟周期内完成，无额外气泡

【关键时序节点】
  - 比较树：48输入min是关键路径，可拆分为2级流水
  - 48个并行的代价计算：DSP资源充足
  - 列RAM：分布式RAM即可，不需要BRAM

===========================================================================
*/
