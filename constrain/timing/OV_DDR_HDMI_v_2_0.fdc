set_false_path -from [get_clocks ddr_clk] -to [get_clocks ioclk2]
set_false_path -from [get_clocks ddr_clk] -to [get_clocks sgm_clk]

set_false_path -from [get_clocks pix_clk] -to [get_clocks cmr_2_pclk]
set_false_path -from [get_clocks pix_clk] -to [get_clocks cmr_1_pclk]
set_false_path -from [get_clocks pix_clk] -to [get_clocks clk_in_50m]
set_false_path -from [get_clocks pix_clk] -to [get_clocks sgm_clk]

set_false_path -from [get_clocks clk_in_50m] -to [get_clocks cmr_2_pclk]
set_false_path -from [get_clocks clk_in_50m] -to [get_clocks cmr_1_pclk]
set_false_path -from [get_clocks clk_in_50m] -to [get_clocks pix_clk]
