define_attribute {p:cmr_2_pclk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:cmr_2_pclk} {PAP_IO_NONE} {TRUE}
define_attribute {n:cmr_2_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}

define_attribute {p:cmr_2_vref} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:cmr_2_vref} {PAP_IO_LOC} {Y5}
define_attribute {p:cmr_2_vref} {PAP_IO_VCCIO} {3.3}
define_attribute {p:cmr_2_vref} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:cmr_2_vref} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n} {PAP_IO_LOC} {K18}
define_attribute {p:rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {R9}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {R8}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx} {PAP_IO_NONE} {TRUE}

create_clock -name {cmr_1_pclk} [get_ports {cmr_1_pclk}] -period {19.841} -waveform {0.000 9.921}
create_clock -name {cmr_2_pclk} [get_ports {cmr_2_pclk}] -period {19.841} -waveform {0.000 9.921}
create_generated_clock -name {ddr_clk} -source [get_ports {clk_in_50m}] [get_nets {ddr3_50h_inst.ddrphy_clkin}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {2} -duty_cycle {50.000}
create_generated_clock -name {ioclk0} -source [get_ports {clk_in_50m}] [get_pins {ddr3_50h_inst.I_GTP_IOCLKBUF_0/CLKOUT}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk1} -source [get_ports {clk_in_50m}] [get_pins {ddr3_50h_inst.I_GTP_IOCLKBUF_1/CLKOUT}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk2} -source [get_ports {clk_in_50m}] [get_pins {ddr3_50h_inst.I_GTP_IOCLKBUF_2/CLKOUT}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk_gate_clk} -source [get_ports {clk_in_50m}] [get_pins {ddr3_50h_inst.u_clkbufg_gate/CLKOUT}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {16} -divide_by {8}
create_generated_clock -name {pix_clk} -source [get_ports {clk_in_50m}] [get_nets {pix_clk_gene.clkout0}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {95} -divide_by {32}
create_generated_clock -name {sgm_clk} -source [get_ports {clk_in_50m}] [get_nets {pix_clk_gene.clkout1}] -master_clock [get_clocks {clk_in_50m}] -multiply_by {19} -divide_by {47}
set_clock_uncertainty {0.200} [get_clocks {cmr_1_pclk}]  -setup -hold
set_clock_uncertainty {0.200} [get_clocks {cmr_2_pclk}]  -setup -hold

set_clock_groups -asynchronous -group {clk_in_50m}  -group {cmr_1_pclk}  -group {cmr_2_pclk} -group {ddr_clk ioclk0 ioclk1 ioclk2 ioclk_gate_clk} -group {pix_clk} -group {sgm_clk}

set_false_path -from [get_clocks cmr_2_pclk] -to [get_clocks clk_in_50m]
set_false_path -from [get_clocks cmr_2_pclk] -to [get_clocks pix_clk]
set_false_path -from [get_clocks cmr_2_pclk] -to [get_clocks cmr_1_pclk]
set_false_path -from [get_clocks cmr_2_pclk] -to [get_clocks ddr_clk]
set_false_path -from [get_clocks cmr_2_pclk] -to [get_clocks sgm_clk]

set_false_path -from [get_clocks cmr_1_pclk] -to [get_clocks clk_in_50m]
set_false_path -from [get_clocks cmr_1_pclk] -to [get_clocks pix_clk]
set_false_path -from [get_clocks cmr_1_pclk] -to [get_clocks cmr_2_pclk]
set_false_path -from [get_clocks cmr_1_pclk] -to [get_clocks ddr_clk]
set_false_path -from [get_clocks cmr_1_pclk] -to [get_clocks sgm_clk]

set_false_path -from [get_clocks ddr_clk] -to [get_clocks clk_in_50m]
